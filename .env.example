# ---------- General ----------
APP_ENV=development                 # development | test | production
APP_BASE_URL=http://localhost:5173  # public URL of the website (used in PDFs and CORS)
LOG_LEVEL=INFO

# ---------- Database ----------
DATABASE_URL=sqlite:///./data/app.db
# For Docker / production:
# DATABASE_URL=postgresql+psycopg://xai:xai@db:5432/xai

# ---------- Security ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
COOKIE_SECURE=false                 # true in production (HTTPS)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Administrator

# ---------- LLM ----------
LLM_PROVIDER=gemini                 # gemini (chosen) | mock (offline/tests) | openai | anthropic (optional)
LLM_MODEL=gemini-flash-latest       # a FREE-TIER Flash model ID; see Section 8.9.5 and Appendix A for how to pick it
GEMINI_API_KEY=                     # free key from Google AI Studio (Appendix A)
OPENAI_API_KEY=                     # optional
ANTHROPIC_API_KEY=                  # optional
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=8192

# ---------- Gemini free-tier pacing (Section 8.9.6) ----------
GEMINI_REQUESTS_PER_MINUTE=4        # keep BELOW your key's free-tier RPM shown in AI Studio (each analysis uses 2 requests)
GEMINI_REQUESTS_PER_DAY=18          # keep BELOW your key's free-tier RPD (was 20/day for gemini-3.8-flash in Oct 2026); resets at midnight US Pacific time
GEMINI_THINKING=low                 # off | low | default — limits "thinking" tokens to keep answers fast and within quota
LLM_MAX_CONCURRENT_JOBS=2           # analyses processed at the same time; extra jobs wait in a queue
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2                   # retries after the first attempt (total attempts = 3)
PROMPT_VERSION=v1

# ---------- Static analysis ----------
SEMGREP_USE_REGISTRY=true           # also use public registry packs (needs internet); vendored rules are always used
STATIC_TOOL_TIMEOUT_SECONDS=30
ESLINT_DIR=/opt/eslint              # folder with node_modules for ESLint (Docker); dev: backend/app/static_analysis/eslint
PMD_BIN=/opt/pmd/bin/pmd            # dev: path to local PMD install, or leave empty to skip PMD

# ---------- Defaults for admin-editable settings (stored in DB after first start) ----------
DEFAULT_MAX_LINES=400
DEFAULT_MAX_CHARS=40000
DEFAULT_GUEST_RETENTION_HOURS=24
DEFAULT_GUEST_RATE_LIMIT_PER_HOUR=10
DEFAULT_USER_RATE_LIMIT_PER_HOUR=30
DEFAULT_CONSISTENCY_CHECK_ENABLED=true
